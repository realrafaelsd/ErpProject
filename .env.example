# Exemplo de configuração local do ERP AI Support.
# Copie para .env e ajuste apenas quando necessário. Este arquivo não contém segredos.

# Endereço HTTP(S) do Ollama; o host deve ser localhost, 127.0.0.1 ou ::1.
OLLAMA_URL=http://localhost:11434

# Modelo local de geração; deve ser um texto não vazio.
OLLAMA_MODEL=qwen3:8b

# Diretório local, legível e gravável, usado pela base vetorial persistente.
CHROMA_PATH=./data/chroma

# Nome não vazio da coleção vetorial única do MVP.
CHROMA_COLLECTION=erp_ai_support

# Diretório local, legível e gravável, usado para uploads temporários.
UPLOAD_FOLDER=./documents/uploads

# Modelo local de embeddings; deve ser um identificador não vazio.
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Máximo de candidatos recuperados por pergunta; inteiro entre 5 e 8.
TOP_K=6

# Tamanho máximo de cada chunk em caracteres; inteiro entre 500 e 1000.
CHUNK_SIZE=800

# Sobreposição entre chunks; inteiro entre 0 e um caractere abaixo do tamanho do chunk.
CHUNK_OVERLAP=150

# Similaridade mínima aceita; número entre -1 e 1.
RELEVANCE_THRESHOLD=0.30

# Limite positivo do arquivo compactado em MiB (1 MiB = 1.048.576 bytes).
MAX_UPLOAD_MB=100

# Quantidade máxima positiva de entradas no ZIP.
MAX_ZIP_ENTRIES=1000

# Limite positivo por entrada descompactada em MiB (1 MiB = 1.048.576 bytes).
MAX_ZIP_ENTRY_MB=100

# Limite positivo total descompactado em MiB, igual ou superior ao limite por entrada.
MAX_UNCOMPRESSED_MB=500

# Razão máxima de compressão; número maior ou igual a 1.
MAX_COMPRESSION_RATIO=100

# Comprimento máximo positivo da pergunta em pontos de código Unicode.
MAX_QUESTION_CHARS=2000

# Timeout local do Ollama em segundos; inteiro entre 1 e 600.
OLLAMA_TIMEOUT_SECONDS=120

# Limite da resposta em tokens; inteiro entre 64 e 2048.
MAX_ANSWER_TOKENS=500

# Host Flask local; deve ser localhost, 127.0.0.1 ou ::1.
FLASK_HOST=127.0.0.1

# Porta Flask; inteiro entre 1 e 65535.
FLASK_PORT=5000

# Modo de depuração; aceita somente true ou false.
FLASK_DEBUG=false
